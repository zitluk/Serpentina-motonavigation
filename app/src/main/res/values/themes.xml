<resources>
    <style name="Theme.Motonavigace" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#E53935</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFDAD6</item>
        <item name="colorSecondary">#37474F</item>
        <!-- Velká tlačítka a volby – ovladatelné v motorkářských rukavicích -->
        <item name="materialButtonStyle">@style/Glove.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Glove.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Glove.Button.Text</item>
        <item name="chipStyle">@style/Glove.Chip</item>
        <item name="materialAlertDialogTheme">@style/Glove.AlertDialog</item>
    </style>
    <style name="Theme.Motonavigace.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">#E53935</item>
        <!-- Velká tlačítka a volby – ovladatelné v motorkářských rukavicích -->
        <item name="materialButtonStyle">@style/Glove.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Glove.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Glove.Button.Text</item>
        <item name="chipStyle">@style/Glove.Chip</item>
        <item name="materialAlertDialogTheme">@style/Glove.AlertDialog</item>
    </style>
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Výška 64 dp (viditelně 56 dp) a větší písmo; běžná tlačítka mají 48 dp -->
    <style name="Glove.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="Glove.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="Glove.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Glove.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Glove.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>
    <style name="Glove.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Glove.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Glove.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Glove.Button.Text</item>
    </style>
    <!-- Přepínací volba do mřížky: stejně široké buňky, vybraná plnou barvou -->
    <style name="Glove.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/glove_toggle_bg</item>
        <item name="android:textColor">@color/glove_toggle_text</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <!-- Akční tlačítka pod volbami: stejný tvar a výška jako mřížka voleb -->
    <style name="Glove.Action" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Glove.Action.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">2dp</item>
    </style>
</resources>
