<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView style="@style/SettingsHeader" android:text="@string/settings_appearance" />
        <include android:id="@+id/theme" layout="@layout/item_setting" />
        <include android:id="@+id/nightMap" layout="@layout/item_setting" />

        <TextView style="@style/SettingsHeader" android:text="@string/settings_bike" />
        <include android:id="@+id/manufacturer" layout="@layout/item_setting" />
        <include android:id="@+id/roadType" layout="@layout/item_setting" />

        <TextView style="@style/SettingsHeader" android:text="@string/settings_marker" />
        <include android:id="@+id/markerShape" layout="@layout/item_setting" />
        <include android:id="@+id/markerColor" layout="@layout/item_setting" />

        <TextView style="@style/SettingsHeader" android:text="@string/settings_language" />
        <include android:id="@+id/language" layout="@layout/item_setting" />
        <include android:id="@+id/voice" layout="@layout/item_setting" />

        <TextView style="@style/SettingsHeader" android:text="@string/settings_data" />
        <include android:id="@+id/mobileData" layout="@layout/item_setting" />
        <include android:id="@+id/showPoi" layout="@layout/item_setting" />

        <TextView style="@style/SettingsHeader" android:text="@string/settings_about" />
        <include android:id="@+id/about" layout="@layout/item_setting" />
        <include android:id="@+id/update" layout="@layout/item_setting" />
        <include android:id="@+id/feedback" layout="@layout/item_setting" />
        <include android:id="@+id/share" layout="@layout/item_setting" />

        <!-- Stálý odkaz na nejnovější verzi (Serpentina-latest.apk) – kamarád si ho naskenuje z displeje -->
        <ImageView
            android:id="@+id/shareQr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/share_qr_description"
            android:scaleType="fitCenter"
            android:src="@drawable/share_qr" />

        <include android:id="@+id/donate" layout="@layout/item_setting" />

        <!-- QR Platba na účet vývojáře, rozbalí se ťuknutím na položku; bílý podklad je součástí
             obrázku, takže jde naskenovat i v tmavém režimu -->
        <ImageView
            android:id="@+id/donateQr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/donate_qr_description"
            android:scaleType="fitCenter"
            android:src="@drawable/donate_qr"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
