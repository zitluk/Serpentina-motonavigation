<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.oscim.android.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Horní část: vyhledávání + tlačítka, při navigaci panel s dalším manévrem -->
    <LinearLayout
        android:id="@+id/topArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Menu jako samostatné velké tlačítko – trefí se i v rukavici -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/menu"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="20dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_menu"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="40dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/searchText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/search_bar"
                    android:textSize="20sp"
                    app:drawableStartCompat="@drawable/ic_search" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Při navigaci: menu vlevo nahoře jako u vyhledávání, vedle panel s dalším manévrem -->
        <LinearLayout
            android:id="@+id/navTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavMenu"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/menu"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="20dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_menu"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="40dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/navBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#263238"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/navArrow"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="48sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/navDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/navInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#CFD8DC"
                            android:textSize="18sp" />

                        <!-- Doporučené pruhy před manévrem (plní MainActivity) -->
                        <LinearLayout
                            android:id="@+id/navLanes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/lanes_bg"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- Vpravo je sloupec tlačítek, štítky do něj nesmí zasahovat -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_marginEnd="84dp"
                android:orientation="vertical">

                <!-- Indikátor probíhajícího záznamu jízdy -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/recChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"
                    app:chipMinHeight="48dp"
                    app:chipBackgroundColor="#C62828"
                    app:chipIcon="@drawable/ic_record"
                    app:chipIconSize="12dp"
                    app:chipIconTint="#FFFFFF" />

                <!-- Nejbližší radar před jezdcem; červený při překročení povolené rychlosti -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/radarCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#263238"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <TextView
                        android:id="@+id/radarText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_speed_camera" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Mapa se vycentruje až na přesnou polohu; do té doby čekáme.
                     Karta místo čipu, ať se delší text zalomí místo useknutí. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/gpsWaiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/gpsChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/waiting_for_precise_location"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:drawableStartCompat="@drawable/ic_my_location" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Na GitHubu vyšla novější verze aplikace -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/updateCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/updateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_download" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnUpdateDownload"
                                style="@style/Glove.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="24dp"
                                android:text="@string/update_download" />

                            <Button
                                android:id="@+id/btnUpdateDismiss"
                                style="@style/Glove.Action.Outlined"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/update_dismiss"
                                app:icon="@drawable/ic_close"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="vertical">

                <!-- Všechna tlačítka 64 dp, aby se dala trefit v rukavicích.
                     Záznam jízdy vždy po ruce – otevře nabídku Záznam jízdy, během záznamu je červený. -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnRecord"
                    style="?attr/floatingActionButtonSecondaryStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/recording_title"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="30dp"
                    app:srcCompat="@drawable/ic_record"
                    app:tint="#C62828" />

                <!-- Režim zobrazení mapy: 3D / 2D / sever nahoře -->
                <Button
                    android:id="@+id/btnViewMode"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/view_mode"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:maxLines="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnLocation"
                    style="?attr/floatingActionButtonSecondaryStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/my_location"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="30dp"
                    app:srcCompat="@drawable/ic_my_location" />

                <!-- Přiblížení tlačítky – roztažení dvěma prsty v rukavicích nejde -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnZoomIn"
                    style="?attr/floatingActionButtonSecondaryStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/zoom_in"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="34dp"
                    app:srcCompat="@drawable/ic_zoom_in" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnZoomOut"
                    style="?attr/floatingActionButtonSecondaryStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/zoom_out"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="34dp"
                    app:srcCompat="@drawable/ic_zoom_out" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/noMapsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="104dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_maps"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <Button
                android:id="@+id/btnNoMapsDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/offline_data" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel trasy -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:visibility="gone">

        <!-- Na nízkých obrazovkách (na šířku) se obsah panelu dá posouvat -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/routePanelScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/destinationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:visibility="gone" />

                <!-- U projížďky po okolí: nový okruh jiným směrem -->
                <Button
                    android:id="@+id/btnNewLoop"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/round_trip_other"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/routeStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hint_long_press"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <ProgressBar
                    android:id="@+id/routeProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Alternativní trasy (plní MainActivity) -->
            <LinearLayout
                android:id="@+id/routeAlternatives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/routeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Typy trasy v mřížce o dvou sloupcích (plní MainActivity), zarovnané do bloku -->
                <LinearLayout
                    android:id="@+id/routeTypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipMotorways"
                        style="@style/Glove.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/avoid_motorways" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipUnpaved"
                        style="@style/Glove.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/avoid_unpaved" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipFerries"
                        style="@style/Glove.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/avoid_ferries" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/routeButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnReverse"
                    style="@style/Glove.Action.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/reverse_route" />

                <Button
                    android:id="@+id/btnClear"
                    style="@style/Glove.Action.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/clear_route" />

                <Button
                    android:id="@+id/btnNavigate"
                    style="@style/Glove.Action"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/navigate" />
            </LinearLayout>
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Spodní panel během navigace -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Rychlost podle GPS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_horizontal"
                android:minWidth="72dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/speed_unknown"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_unit"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/navRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStopNav"
                style="@style/Glove.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:minWidth="120dp"
                android:text="@string/stop_navigation"
                android:textSize="20sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Úvodní logo zvoleného výrobce přes celou šířku displeje (plní a po 5 s skryje MainActivity);
         zachytává dotyky, ať se pod ním nedá omylem ovládat mapa -->
    <FrameLayout
        android:id="@+id/startLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/startLogoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
